<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Hurgent Hai Ios</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>hurgent_hai_ios</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ─── URL Schemes ─── -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>tel</string>
        <string>maps</string>
        <string>comgooglemaps</string>
    </array>

    <!-- ─── Location Permissions (geolocator, geocoding, google_maps_flutter) ─── -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>UrgentHai needs your location to show nearby rides, parcels, and stores around you.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>UrgentHai needs your location in the background to track your ride or delivery in real time.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>UrgentHai needs your location in the background to track your ride or delivery in real time.</string>

    <!-- ─── Camera & Photo Library (image_picker) ─── -->
    <key>NSCameraUsageDescription</key>
    <string>UrgentHai needs camera access to let you upload profile photos or parcel images.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>UrgentHai needs access to your photo library to let you choose a profile or parcel photo.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>UrgentHai needs permission to save photos to your library.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>UrgentHai needs microphone access for video recording if you capture a parcel video.</string>

    <!-- ─── Notifications (flutter_local_notifications) ─── -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- ─── Performance ─── -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>